# Install at /opt/backend/.env  (root:root 0644 — same pattern as
# podman-compose.yml, see .env/setup/deploy-user-setup.md Step 3b).
#
# podman-compose loads this file into the container environment (`env_file:` in
# podman-compose.yml). The backend binary maps env names onto its viper flags
# (AutomaticEnv with '-'->'_': DATA_DIR -> --data-dir, LOG_DIR -> --log-dir,
# API_PORT -> --api-port, ...), so any --flag has an env equivalent here.
#
# Persistence layout — bind mounts themselves are defined in
# podman-compose.yml; this file tells the binary where to write INSIDE the
# container:
#   /data  -> host /opt/backend/data/chain   (badger DB + checkpoints)
#   /logs  -> host /opt/backend/data/logs    (glog backend.INFO / .WARNING / ...)

# Chain data directory. The badger DB lands in /data/v-00000/, which is the
# bind mount backed by /opt/backend/data/chain on the host.
DATA_DIR=/data

# glog log directory. backend.INFO etc. appear directly in /logs, i.e. host
# /opt/backend/data/logs — tailable without `podman exec`.
LOG_DIR=/logs

# --- optional (uncomment as needed) ---------------------------------------
# REST API port inside the container. When unset, defaults to the port in the
# DeSoParams set. Publish via `ports:` in podman-compose.yml if you need
# external access.
#API_PORT=18001
# Comma-separated list (no spaces) of remote peers to connect to on startup.
#CONNECT_IPS=
