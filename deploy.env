# Install at /opt/backend/.env  (root:root 0644 — same pattern as
# podman-compose.yml, see .env/setup/deploy-user-setup.md Step 3b).
#
# podman-compose loads this file into the container environment (`env_file:` in
# podman-compose.yml). The backend binary maps env names onto its viper flags
# (AutomaticEnv with '-'->'_': DATA_DIR -> --data-dir, LOG_DIR -> --log-dir,
# API_PORT -> --api-port, ...), so any --flag has an env equivalent here.
#
# Persistence layout — bind mounts themselves are defined in
# podman-compose.yml; this file tells the binary where to write INSIDE the
# container:
#   /data  -> host /opt/backend/data/chain   (badger DB + checkpoints)
#   /logs  -> host /opt/backend/data/logs    (glog backend.INFO / .WARNING / ...)

# Chain data directory. The badger DB lands in /data/v-00000/, which is the
# bind mount backed by /opt/backend/data/chain on the host.
DATA_DIR=/data

# glog log directory. backend.INFO etc. appear directly in /logs, i.e. host
# /opt/backend/data/logs — tailable without `podman exec`.
LOG_DIR=/logs

# ----------------------------------------------------------------------------
# forked-social seed node (mainnet-style fork network)
# ----------------------------------------------------------------------------
# Network selection: mainnet-style fork params (FS1 prefixes, protocol port
# 42000, API port 42001, fork genesis + fork heights). Env equivalent of
# --forknet. For the testnet-style fork use FORKNET_TESTNET=true instead and
# re-point the URLs/ports below at the testnet variant (42420/42421,
# test.forked.social).
FORKNET=true

# REST API port inside the container. Published via `ports:` in
# podman-compose.yml (loopback only — terminate TLS on the host reverse proxy
# serving https://node.forked.social).
API_PORT=42001

# OPTIONAL $DESO price-source toggles, both disabled by default on this fork (no dusdc_ profile; CLOUT-USD delisted): BLOCKCHAIN_COM_RATE_ENABLED=true / DESO_DEX_RATE_ENABLED=true re-enable them; flag equivalents --blockchain-com-rate-enabled / --deso-dex-rate-enabled win over env (flag wiring pending commit, env form already effective).

# Checkpoint syncing: the seed self-references its own in-container API.
# The public hostname is not a valid checkpoint provider until a host reverse
# proxy terminates TLS for node.forked.social. Loopback keeps the checkpoint
# provider local and avoids exposing the API. The first cold-start call can
# still fail because the backend API starts after this initial checkpoint
# update; once the API answers, updates succeed instead of flooding errors.
CHECKPOINT_SYNCING_PROVIDERS=http://127.0.0.1:42001

# Peering. CONNECT_IPS is deliberately UNSET on the seed node: it must not
# gate itself behind a fixed peer list. Joining nodes set e.g.
# CONNECT_IPS=node.forked.social:42000.
#CONNECT_IPS=

# Single-server launch topology: all peers (the three validators) dial this
# seed via node.forked.social, hairpinning through rootless podman (pasta)
# into the seed's netns — the seed sees them ALL as its network gateway IP
# (10.89.0.1). The anti-sybil one-inbound-per-ip limit (core code default
# true) would cap the seed at ONE inbound peer, so opt out here.
ONE_INBOUND_PER_IP=false

# Governance/admin (founder-root key).
ADMIN_PUBLIC_KEYS=FS13vrbSsSRefiNeoJK5uHMKgCwzJJ3NMCFdEKpui7qPX4X7xSLSko
SUPER_ADMIN_PUBLIC_KEYS=FS13vrbSsSRefiNeoJK5uHMKgCwzJJ3NMCFdEKpui7qPX4X7xSLSko

# Mining (PoW bootstrap only): starts the miner so the seed can mine blocks
# 1..~300 until the PoS cutover. Block rewards are zero — the genesis
# allocation (420,000,000 coins, 42% of the 1,000,000,000-coin supply cap)
# is held by this same miner key.
MINER_PUBLIC_KEYS=FS13xKCghHsuC7Kw6eS1Y7cxePu3ZJ6PbYpxfaZzNcRKEQFXuFU2tp
NUM_MINING_THREADS=1

# ----------------------------------------------------------------------------
# SECRETS — STRUCTURED PLACEHOLDER WIRING.
# SECURITY RULE: no mnemonic/seed phrase may EVER be committed to this or any
# file. The operator injects each secret at runtime (e.g. manually exported
# into this file at deploy time with 0600 perms, or via systemd
# EnvironmentFile= pointing outside the repo). Only public keys are recorded
# here for audit/reference.
# ----------------------------------------------------------------------------

# PoS validator seed (BIP39 mnemonic or seed hex). Setting it makes this node
# run as a Proof of Stake validator at/after the cutover. Validators must
# register + stake on-chain shortly after launch (before the first epoch
# snapshot, ~block 145) — see backend/scripts/pos/validator_registration.go.
# Inject at runtime; leave empty here.
POS_VALIDATOR_SEED=

# Block producer seed: signs PoS blocks produced by this node after cutover.
# Corresponding public key (reference only):
#   FS13wbrugMsxmBzo41C1NGYUjCn4Tt4mQRKjzZAGa51wGCpKPJQ4cP
# Inject at runtime; leave empty here.
BLOCK_PRODUCER_SEED=

# Starter-DESO faucet seed: funds new-user onboarding drips. On the fork
# testnet the designated faucet key is
#   FS13yCzGJGuQNmrsDn6Et74LphomuxnbsshZ3Rwo9k7iuxtLVRqyFV   (pubkey only —
# reference; the faucet key gets config wiring ONLY, no seed material here).
# Inject at runtime on the testnet seed only; leave empty elsewhere.
STARTER_DESO_SEED=
